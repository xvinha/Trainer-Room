{
  "name": "trainer-room",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "cd apps/backend && bun run dev",
    "dev:frontend": "cd apps/frontend && bun run dev",
    "dev": "concurrently -n BACKEND,FRONTEND -c blue,green \"bun run dev:backend\" \"bun run dev:frontend\"",
    "build:backend": "cd apps/backend && bun run build",
    "build:frontend": "cd apps/frontend && bun run build",
    "build": "bun run build:backend && bun run build:frontend",
    "db:generate": "cd apps/backend && bun run db:generate",
    "db:migrate": "cd apps/backend && bun run db:migrate",
    "db:push": "cd apps/backend && bun run db:push",
    "db:studio": "cd apps/backend && bun run db:studio"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.4.5"
  }
}
