# =============================================================================
# Trainer Room — Variáveis de Ambiente Obrigatórias
# =============================================================================
# NÃO EDITE ESTE ARQUIVO! Copie para .env e ajuste os valores de lá.
# NÃO FAÇA COMMIT do arquivo .env no Git/GitHub.

# -----------------------------------------------------------------------------
# 1. Banco de Dados PostgreSQL
# -----------------------------------------------------------------------------
# Render/Railway fornecem esta variável automaticamente.
# Local: postgresql://USUARIO:SENHA@localhost:5432/trainer_room
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trainer_room

# -----------------------------------------------------------------------------
# 2. Autenticação / JWT
# -----------------------------------------------------------------------------
# ⚠️  PRODUÇÃO: gere uma chave ALEATÓRIA de pelo menos 48 caracteres.
# Comando sugerido: openssl rand -base64 48
JWT_SECRET=troque-esta-chave-por-uma-string-longa-e-aleatoria-de-no-minimo-32-caracteres-xyz

# Duração dos tokens de acesso. Formatos aceitos: "7d", "24h", "15m", etc.
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# 3. Administrador Master (acesso ao painel admin do SaaS)
# -----------------------------------------------------------------------------
# ✅ Método RECOMENDADO para PRODUÇÃO — use as duas opções abaixo para
#    definir as credenciais. Elas são carregadas na inicialização e usadas
#    para criar o primeiro usuário ADMIN automáticamente (seed idempotente).

# E-mail do usuário master (login no /login)
ADMIN_EMAIL=pedrofelrv01@gmail.com

# ⚠️  Escolha APENAS UM dos dois abaixo:
#
#  A) ADMIN_PASSWORD   — (mais simples) senha em texto. É HASHEADA no startup.
#     Mínimo 8 caracteres. Para produção, recomendo a opção B.
#
ADMIN_PASSWORD=Vinhaf@1

#  B) ADMIN_PASSWORD_HASH — (mais seguro) hash bcrypt pré-calculado.
#     Nenhuma senha em texto plano chega ao servidor.
#     Gere com:  bun run apps/backend/src/scripts/hash-password.ts "sua-senha"
#
# ADMIN_PASSWORD_HASH=cole_o_hash_bcrypt_aqui

# -----------------------------------------------------------------------------
# 4. Servidor e Rede
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001

# Origens permitidas no CORS (separadas por vírgula). Use * apenas localmente.
# Ex produção: https://app.seudominio.com,https://admin.seudominio.com
CORS_ORIGIN=*

# -----------------------------------------------------------------------------
# 5. Segurança (opcional)
# -----------------------------------------------------------------------------
# Chave para autorizar POST /api/setup/master (ENDPOINT EXISTE SÓ EM DEV!).
# Se definida, qualquer chamada precisa do header X-Setup-Key: <valor>.
# SETUP_KEY=

# -----------------------------------------------------------------------------
# 6. Configuração dos IDs de Aluno (opcional)
# -----------------------------------------------------------------------------
# Tamanho do código alfanumérico único (6-16). Maior = menos colisões.
STUDENT_ID_LENGTH=8
# Caracteres permitidos — por padrão sem I, O, 0, 1 ambíguos.
STUDENT_ID_ALPHABET=ABCDEFGHJKLMNPQRSTUVWXYZ23456789
